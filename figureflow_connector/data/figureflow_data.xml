<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- AIDEV-NOTE: Default FigureFlow URLs. Admins can override these from
         Settings > FigureFlow if connecting to a non-production environment.
         api.* is hit server-to-server during the marketplace handshake.
         web.* is where the user's browser is redirected after handshake. -->
    <record id="figureflow_default_api_url" model="ir.config_parameter">
        <field name="key">figureflow_connector.api_url</field>
        <field name="value">https://api.figureflow.app</field>
    </record>

    <record id="figureflow_default_web_url" model="ir.config_parameter">
        <field name="key">figureflow_connector.web_url</field>
        <field name="value">https://web.figureflow.app</field>
    </record>

    <record id="figureflow_default_connection_status" model="ir.config_parameter">
        <field name="key">figureflow_connector.connection_status</field>
        <field name="value">disconnected</field>
    </record>
</odoo>
