<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_figureflow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.figureflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="FigureFlow"
                     string="FigureFlow"
                     name="figureflow_connector"
                     groups="base.group_system">
                    <block title="FigureFlow AI CFO" name="figureflow_settings_block">
                        <setting id="figureflow_connection_status_setting"
                                 string="Connection"
                                 help="Status of the FigureFlow connection for this Odoo instance.">
                            <field name="figureflow_connection_status"
                                   readonly="1"
                                   placeholder="Not connected"/>
                            <div class="content-group mt-3">
                                <button name="action_figureflow_connect"
                                        type="object"
                                        string="Connect to FigureFlow"
                                        class="btn-primary"/>
                                <button name="action_figureflow_open_dashboard"
                                        type="object"
                                        string="Open FigureFlow Dashboard"
                                        class="btn-link"/>
                                <button name="action_figureflow_disconnect"
                                        type="object"
                                        string="Disconnect"
                                        class="btn-link"
                                        confirm="Revoke the FigureFlow API key on this Odoo? You will also need to disconnect from inside FigureFlow to fully remove the integration."/>
                            </div>
                            <div class="text-muted mt-2">
                                <p>
                                    Click <b>Connect</b> to generate an Odoo API
                                    key and open FigureFlow in a new tab. We
                                    send your Odoo URL, database name, login
                                    and the generated API key directly to
                                    FigureFlow over HTTPS — the credentials
                                    never travel through your browser.
                                </p>
                                <p>
                                    FigureFlow uses these credentials to read
                                    your chart of accounts, journal entries,
                                    partners and invoices. Nothing is sent
                                    before you click Connect. See the
                                    <a href="https://www.figureflow.com/privacy"
                                       target="_blank">privacy policy</a>.
                                </p>
                            </div>
                        </setting>
                        <setting id="figureflow_base_url_setting"
                                 string="FigureFlow URL"
                                 help="Change only if you're connecting to a non-production FigureFlow environment.">
                            <field name="figureflow_base_url" placeholder="https://app.figureflow.com"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_figureflow_settings" model="ir.actions.act_window">
        <field name="name">FigureFlow Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'figureflow_connector'}</field>
    </record>
</odoo>
